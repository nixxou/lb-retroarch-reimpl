<Project Sdk="Microsoft.NET.Sdk">

  <!-- Faux retroarch.exe des cas V : rejoue octet pour octet out.bin (stdout) et err.bin (stderr) poses a cote. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>retroarch</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

</Project>
